# Spliit on Railway — environment variables.
# Everything here is auto-wired on a one-click deploy; nothing needs typing.
# See README.md "Configuration" for what each variable does.

# App service (spliit)
SPLIIT_DB_HOST=${{postgres.RAILWAY_PRIVATE_DOMAIN}}
SPLIIT_DB_PASSWORD=${{postgres.POSTGRES_PASSWORD}}
# BASE_URL is NOT a deploy variable: the entrypoint derives it at boot
# from RAILWAY_PUBLIC_DOMAIN (a variable value of
# https://${{RAILWAY_PUBLIC_DOMAIN}} resolved to a bare https:// in e2e
# and crashed page renders). Set BASE_URL manually only for a custom
# domain, where the entrypoint leaves a valid value alone.
# Optional upstream features (off by default; see README.md):
# DEFAULT_CURRENCY_CODE=USD
# ENABLE_GROUP_DELETION=false
# ENABLE_EXPENSE_DOCUMENTS=false (requires S3_UPLOAD_* below)
# S3_UPLOAD_KEY=
# S3_UPLOAD_SECRET=
# S3_UPLOAD_BUCKET=
# S3_UPLOAD_REGION=
# S3_UPLOAD_ENDPOINT=

# Companion service (postgres)
POSTGRES_PASSWORD=${{secret(32)}}
# Baked into postgres/Dockerfile (not deploy-form fields):
# POSTGRES_USER=spliit, POSTGRES_DB=spliit, PGDATA=/var/lib/postgresql/data/pgdata
